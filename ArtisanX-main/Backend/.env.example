# ============================================================
# KALASETU ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env and fill in your API credentials.
# All services have intelligent fallback mocks so the app works
# smoothly even before external API keys are configured!

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Database Configuration
# Defaults to SQLite if PostgreSQL is not running
DATABASE_URL=sqlite:///./kalasetu.db
# DATABASE_URL=postgresql+psycopg://kalasetu:kalasetu_password@localhost:5432/kalasetu_db

# JWT Authentication Secret
SECRET_KEY=kalasetu_super_secret_jwt_key_2026_cultural_heritage_platform
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ============================================================
# 1. GOOGLE GEMINI API (Generative AI & NLP)
# ============================================================
# Get free key from: https://aistudio.google.com/
# Used for: Craft title & description generation, smart pricing, KalaSathi chatbot
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ============================================================
# 2. GOOGLE CLOUD VISION API (Visual Craft Recognition)
# ============================================================
# Get key from: https://console.cloud.google.com/apis/credentials
# Used for: Identifying craft materials, colors, objects, pottery styles from photos
GOOGLE_CLOUD_VISION_API_KEY=
# Or path to service account json file:
# GOOGLE_APPLICATION_CREDENTIALS=./gcp-service-account.json

# ============================================================
# 3. RAZORPAY PAYMENT GATEWAY (Indian Payments: UPI, Cards)
# ============================================================
# Get test keys from: https://dashboard.razorpay.com/app/keys
# Used for: UPI QR code, PhonePe, GPay, Paytm, Cards, Netbanking
RAZORPAY_KEY_ID=rzp_test_kalasetu_sample
RAZORPAY_KEY_SECRET=sample_razorpay_secret_key_123

# ============================================================
# 4. BHASHINI API (Govt. of India Indian Languages Voice & NLP)
# ============================================================
# Get credentials from: https://bhashini.gov.in/ulca
# Used for: Speech-to-Text (ASR), Text-to-Speech (TTS), Translation in Indian languages
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=

# ============================================================
# 5. SMS GATEWAY FOR PHONE OTP (Fast2SMS or Twilio)
# ============================================================
# Fast2SMS (Indian SMS): https://www.fast2sms.com/
FAST2SMS_API_KEY=
# Or Twilio: https://www.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
